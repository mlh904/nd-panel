# ===== 复制为 .env 后按需修改 =====

# 面板对外端口
PANEL_PORT=3010

# 管理员用户名（密码放 secrets/nd_botadmin_pass）
ND_ADMIN_USER=botadmin

# Navidrome 线路，JSON 数组。name 是显示名，url 是 Navidrome 根地址
# 同机容器访问宿主用 docker 网关 IP，不要用 127.0.0.1
ND_SERVERS=[{"name":"音乐1号","url":"http://192.168.1.10:4533"},{"name":"音乐2号","url":"https://music.example.com"}]

# 统计代理，JSON 数组。不填则播放数据页显示为空
ND_STATS_SERVERS=[{"name":"音乐1号","url":"http://192.168.1.10:3999"},{"name":"音乐2号","url":"http://192.168.1.11:3999"}]
